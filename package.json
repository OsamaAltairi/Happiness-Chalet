{
  "name": "happiness-chalet-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Happiness Chalet booking site with Node.js local development and Cloudflare Pages Functions",
  "scripts": {
    "build": "node scripts/build-pages.js",
    "deploy": "wrangler deploy --env=\"\"",
    "start": "node server.js",
    "db:migrate:remote": "wrangler d1 migrations apply my-binding --remote",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
